rules_version = '2';

// Security rules for the weddingrsvps-62c62 Firestore project, backing the
// RSVP system in index.html. Paste this into the Firebase console under
// Firestore Database -> Rules (or deploy with the Firebase CLI) — this file
// is not applied automatically, it just lives in the repo as the source of
// truth for what the rules should be.
//
// ============================ READ THIS ============================
// This collection is fully public: anyone can read it, add to it, and
// DELETE FROM IT. That is a deliberate, accepted tradeoff, not an
// oversight — the admin page needs to add and remove guests, its password
// is checked in the browser, and Firestore never sees that password. All
// the database sees is an unauthenticated request carrying an apiKey that
// is public by design (it ships in the page source; Firebase web API keys
// are identifiers, not secrets). So the rules cannot tell the couple apart
// from any other visitor, and permissions granted to the admin UI are
// necessarily granted to everyone.
//
// Concretely: someone who views source can wipe the entire guest list and
// every RSVP collected so far. The mitigations below are the guardrails
// that are actually possible without real auth:
//   - writes must be well-formed guest records (see the validators), so
//     the collection can't be filled with arbitrary junk or huge payloads
//   - an update may only touch the response fields (status, vegetarian,
//     notes, respondedAt, maxGuests, attendingCount), so a guest RSVPing
//     can't rewrite someone's name
//   - every RSVP is also appended to /rsvpHistory, which nobody can edit or
//     delete, so an overwritten answer can always be traced and restored
//   - the admin page has an "Export CSV" button; taking a backup now and
//     then is the recovery path if the list is ever destroyed
//
// The fix, if this ever matters more: enable Firebase Authentication,
// create one admin account, and change `allow create, delete` (and
// ideally the broad update rule) to require `request.auth.uid == '<uid>'`.
// That is the only way to give the couple write access without giving it
// to the whole internet.
// ===================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /guests/{guestId} {

      // A well-formed guest record. Applied to creates and to the result of
      // any update, so no write can leave a document in a shape the app
      // doesn't understand.
      //
      // maxGuests is how many people one invitation covers (a couple is 2, a
      // family of four is 4); attendingCount is how many of those actually
      // confirmed. The last clause is the important one: a guest can never
      // confirm more people than their invitation was given seats for.
      function validGuest(d) {
        return d.name is string
            && d.name.size() > 0
            && d.name.size() <= 120
            && d.status in ['yes', 'no', 'pending']
            && (d.vegetarian == null || d.vegetarian in ['yes', 'no'])
            && d.notes is string
            && d.notes.size() < 1000
            && d.maxGuests is int
            && d.maxGuests >= 1
            && d.maxGuests <= 20
            && (d.attendingCount == null
                || (d.attendingCount is int
                    && d.attendingCount >= 0
                    && d.attendingCount <= d.maxGuests));
      }

      allow read: if true;

      // Adding a guest from the admin page. New guests always start pending
      // with nobody confirmed yet.
      allow create: if validGuest(request.resource.data)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.attendingCount == null;

      // RSVP submissions and admin edits. The affectedKeys() guard is what
      // stops a guest from overwriting another field (their own name most
      // importantly) while responding.
      //
      // maxGuests has to be in this list because the admin page edits seat
      // counts inline, and — as noted above — the rules can't tell the admin
      // from a guest. So a determined guest could raise their own seat count
      // before confirming. The <= 20 cap in validGuest bounds how far that can
      // go, and it is strictly less damaging than the delete access already
      // granted below. Firebase Auth is the fix if that ever matters.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'vegetarian', 'notes', 'respondedAt',
                                  'maxGuests', 'attendingCount'])
                    && validGuest(request.resource.data);

      // Removing a guest from the admin page. Unrestricted — see the note
      // at the top of this file.
      allow delete: if true;
    }

    // Append-only log of every RSVP submission, read by the admin page's
    // History view. Readable like the guest list (the admin page has no real
    // auth), but entries can never be edited or deleted. The page writes
    // these best-effort, so an RSVP still goes through if this is rejected.
    match /rsvpHistory/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['guestId', 'guestName', 'status',
                           'vegetarian', 'notes', 'attendingCount', 'deviceId', 'userAgent', 'at'])
                    && request.resource.data.guestId is string
                    && exists(/databases/$(database)/documents/guests/$(request.resource.data.guestId))
                    && request.resource.data.at == request.time
                    && request.resource.data.guestName is string
                    && request.resource.data.guestName.size() <= 120
                    && request.resource.data.status in ['yes', 'no']
                    && request.resource.data.notes is string
                    && request.resource.data.notes.size() < 1000
                    && request.resource.data.deviceId is string
                    && request.resource.data.deviceId.size() <= 64
                    && request.resource.data.userAgent is string
                    && request.resource.data.userAgent.size() <= 300;
      allow update, delete: if false;
    }
  }
}
