rules_version = '2';

// Security rules for the weddingrsvps-62c62 Firestore project, backing the
// RSVP system in index.html. Paste this into the Firebase console under
// Firestore Database -> Rules (or deploy with the Firebase CLI) — this file
// is not applied automatically, it just lives in the repo as the source of
// truth for what the rules should be.
//
// Design:
// - `guests` is readable by anyone, no auth required. That matches the old
//   guestlist.json.b64 file this replaced, which was also fully public (base64
//   is encoding, not encryption — anyone could already decode the whole guest
//   list from the deployed site). This is not a new exposure.
// - The admin page's hardcoded password is a client-side convenience for the
//   couple, NOT real access control — anyone can read it out of the page
//   source (it's hex, not encryption) and call Firestore directly with the
//   public apiKey regardless of what the admin UI does. These rules are what
//   actually protects the data: a public site can't restrict *reads* of a
//   collection a public admin page needs to list without real user auth, but
//   it CAN restrict *writes* at the database level, independent of anything
//   the client claims about who it is. That's what this does:
//     - no one can create a new guest document or delete one from the client
//       (only the one-time seed script does that, and it doesn't run through
//       these rules)
//     - an update may only touch status/vegetarian/notes/respondedAt — a
//       guest's `name` and `createdAt` can't be overwritten from the RSVP form
//     - status/vegetarian are constrained to known values, notes is capped
//       at 1000 characters, so a malicious client can't stuff garbage or huge
//       payloads into the collection
//
// If this list is ever more sensitive than "who's coming to the wedding and
// what they want to eat," this whole approach (public read, rules-limited
// write, no real auth) is the wrong model — that would need actual Firebase
// Authentication and per-user rules instead.
service cloud.firestore {
  match /databases/{database}/documents {
    match /guests/{guestId} {
      allow read: if true;

      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'vegetarian', 'notes', 'respondedAt'])
                    && request.resource.data.status in ['yes', 'no', 'pending']
                    && (request.resource.data.vegetarian == null
                        || request.resource.data.vegetarian in ['yes', 'no'])
                    && request.resource.data.notes is string
                    && request.resource.data.notes.size() < 1000;

      allow create, delete: if false;
    }
  }
}
